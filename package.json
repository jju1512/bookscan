{
  "name": "bookscan",
  "private": true,
  "version": "0.0.0",
  "description": "안드로이드 크롬용 북스캔 웹앱 (정적 PWA)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run vendor && vite",
    "dev:https": "npm run vendor && vite --host --mode https",
    "build": "npm run vendor && npm run typecheck && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "vendor": "node scripts/copy-vendor.mjs",
    "e2e:capture": "node scripts/e2e/capture.mjs",
    "fixtures": "node tests/synthetic/generate.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.8",
    "pdfjs-dist": "^6.5.438",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "tesseract.js": "^7.0.0"
  }
}
